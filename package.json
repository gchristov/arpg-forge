{
  "name": "arpg-forge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "vite preview --outDir .play --port 5173",
    "play:update": "vite build --outDir .play --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "three": "0.187.0"
  }
}
